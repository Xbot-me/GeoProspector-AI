# Copy to .env and fill in. Never commit .env.

# ── Required ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
ADMIN_PASSWORD=change-me
DATABASE_URL=postgresql://appuser:secretpassword@localhost:5432/geoprospector

# ── Business data source ─────────────────────────────────────────────────
# overture (default): free Overture Maps open data, no key. Reviews are found
#   on business websites and review sites (Yelp, BBB, Birdeye, ...).
# google: Places API (needs GOOGLE_PLACES_API_KEY + billing), has Google reviews.
PLACES_PROVIDER=overture
OVERTURE_RELEASE=latest
OVERTURE_MIN_CONFIDENCE=0.5
NOMINATIM_USER_AGENT=           # free geocoder; identify your app, e.g. "MyAgency-Leads/1.0 (+https://example.com)"

# Only for PLACES_PROVIDER=google
GOOGLE_PLACES_API_KEY=
MAX_PLACES_CALLS_PER_MONTH=1000

# ── Optional contact enrichment (free tiers) ─────────────────────────────
HUNTER_API_KEY=                 # hunter.io: named people, roles, emails, LinkedIn
COMPANIES_HOUSE_API_KEY=        # UK company directors (developer.company-information.service.gov.uk)
ENABLE_WEB_SEARCH=true          # DuckDuckGo: Facebook/Instagram/LinkedIn profile URLs

# ── Email sending ────────────────────────────────────────────────────────
# Local development: keep AUTO_SEND_EMAILS=false and leave provider keys empty.
AUTO_SEND_EMAILS=false
MAX_DAILY_EMAILS=20
MIN_LEAD_SCORE=0
EMAIL_PROVIDER=resend           # resend | smtp
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Sender identity / compliance ─────────────────────────────────────────
SENDER_NAME=
SENDER_PHYSICAL_ADDRESS=
UNSUBSCRIBE_BASE_URL=
ADMIN_USERNAME=admin
GEMINI_MODEL=gemini-flash-lite-latest
