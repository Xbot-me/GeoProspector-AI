# Copy to .env and fill in. Nothing here is committed with real values.

# --- Required ---
GOOGLE_PLACES_API_KEY=          # needs a Google Cloud billing account (free tier covers ~5,000 searches/month)
GEMINI_API_KEY=                 # free key, no card: https://aistudio.google.com
DATABASE_URL=postgresql://appuser:secretpassword@localhost:5432/geoprospector
ADMIN_PASSWORD=                 # dashboard login; a random one is printed at startup if empty

# --- Safety (leave as is until your sending domain is warmed up) ---
AUTO_SEND_EMAILS=false          # when false nothing is ever sent automatically
REQUIRE_APPROVAL=true           # only leads you approve in the dashboard are sent
MAX_DAILY_EMAILS=10             # 5-10/day for the first weeks on a new domain
MAX_PLACES_CALLS_PER_MONTH=4000 # local safety counter below Google's 5,000 free calls

# --- Who you are (used in the signature and email layout) ---
SENDER_NAME=
SENDER_TITLE=Full-Stack Web Developer
SENDER_WEBSITE=https://example.com
SENDER_EMAIL=you@example.com
SENDER_PHONE=                   # optional
SENDER_PHYSICAL_ADDRESS=        # required by CAN-SPAM in every commercial email
OUTREACH_LANGUAGE=English       # or "auto" to write in the local language of each lead

# --- Sending (pick one) ---
EMAIL_PROVIDER=resend           # resend | smtp
RESEND_API_KEY=
EMAIL_FROM=                     # "Your Name <you@your-sending-domain.com>"; use a separate sending domain
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Unsubscribe / tracking ---
# Leave empty when running on a PC: emails then use a mailto: unsubscribe and
# open tracking is off. Set to a public URL (e.g. a Cloudflare Tunnel) to
# get one-click unsubscribe and open tracking.
UNSUBSCRIBE_BASE_URL=
TRACKING_BASE_URL=

# --- Targeting ---
# Countries where opt-out cold B2B email is lawful. Germany, Spain, Italy and
# others need consent; UK sole traders too. Check local rules before adding any.
OUTREACH_COUNTRIES=USA,Canada,Australia
MIN_LEAD_SCORE=0
MAX_PLACES_RESULTS_PER_RUN=60

# --- Optional ---
HUNTER_API_KEY=                 # last-resort email lookup, safe to skip
ENABLE_WEB_SEARCH=true
ENABLE_PAGESPEED=true           # free Google PageSpeed audit of live sites
PAGESPEED_API_KEY=              # optional, raises the rate limit
PAGESPEED_SLOW_THRESHOLD=50
OFFER_FREE_MOCKUP=false         # only turn on if you will build one for every reply
FOLLOWUP_ENABLED=true
FOLLOWUP_AFTER_DAYS=5
